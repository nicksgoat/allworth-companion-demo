{
  "name": "allworth-mobile-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test apps/mobile/tests/*.test.mjs",
    "test:api": "cd services/api && ../../.venv/bin/python -m pytest",
    "test:all": "./scripts/test.sh",
    "dev:api": "./scripts/dev-api.sh",
    "dev:mobile": "./scripts/dev-mobile.sh",
    "start:all:win": "powershell -ExecutionPolicy Bypass -File ./scripts/start-all.ps1",
    "sync:upstream": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-upstream.ps1",
    "sync:upstream:dry": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-upstream.ps1 -DryRun"
  },
  "workspaces": [
    "apps/mobile"
  ]
}

