# Azure Synapse Connection Settings
SYNAPSE_SERVER=allworthsynapse.sql.azuresynapse.net
SYNAPSE_DATABASE=DataWarehouse

# ODBC Driver Configuration
# - Use "ODBC Driver 17 for SQL Server" for local Windows development
# - Use "ODBC Driver 18 for SQL Server" for Docker/production (default)
ODBC_DRIVER={ODBC Driver 17 for SQL Server}

# Authentication Method: Choose one of:
# - ServicePrincipal: Use Azure AD Service Principal (requires AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID)
# - SqlPassword: Use SQL authentication (requires SYNAPSE_USERNAME, SYNAPSE_PASSWORD)
# - ActiveDirectoryInteractive: Use browser-based auth (local development only, not for containers)
AUTH_METHOD=ServicePrincipal

# Service Principal Credentials (for containers/production)
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_TENANT_ID=your-tenant-id-here

# SQL Authentication (alternative, if enabled on your Synapse)
# SYNAPSE_USERNAME=your-username
# SYNAPSE_PASSWORD=your-password

# Azure Container Registry (for deployment)
ACR_NAME=your-acr-name
ACR_LOGIN_SERVER=your-acr-name.azurecr.io

# Azure Resource Group
RESOURCE_GROUP=your-resource-group
LOCATION=eastus

# Application name (used for Azure deployment)
APP_NAME=allworth-executive-reporting

# -------------------------------------------------------------------
# NFBC Agentic Adjustment Console
# -------------------------------------------------------------------
# Anthropic API key for the proposing agent (Claude reasons; code does math).
ANTHROPIC_API_KEY=
# Override the default model if needed.
NFBC_CLAUDE_MODEL=claude-opus-4-8
# Jira REST v3 (Basic auth: email + API token).
JIRA_URL=https://allworthfinancial.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Queue cache TTL in seconds (default 600).
NFBC_QUEUE_TTL_SECONDS=600

# ── Admin console / access enforcement ──────────────────────────────────────
# Per-user tool access enforcement. OFF by default so a deploy never locks the
# team out before the user roster is populated. Set to 1/true/yes/on to enforce
# (users without access see a "request access" page; the /home hub hides tools
# they lack).
ADMIN_ENFORCEMENT=0
# Comma-separated emails that are always members of the all-access "Admin"
# group (in addition to the built-in owner). Guarantees you can't lock yourself
# out.
ADMIN_BOOTSTRAP_EMAILS=

# Admin roster durability. The roster lives in a local JSON file (fast); to
# survive container restarts it is restored on startup from — and backed up
# daily to — ADLS Gen2 (reuses the ADLS_ACCOUNT_NAME + Azure credentials used
# by the Delta reader). Leave ADMIN_BACKUP_ENABLED unset to auto-enable when
# credentials are present; set 0 to disable.
ADMIN_BACKUP_ENABLED=
# How often the background thread backs up (hours). Default 24 (once a day).
ADMIN_BACKUP_INTERVAL_HOURS=24
# Optional overrides (default: silver container, admin/admin_state.json).
ADMIN_STATE_ADLS_CONTAINER=silver
ADMIN_STATE_ADLS_PATH=admin/admin_state.json
# Read-only replica: mirror the SAME shared roster as prod but never write back
# (used by the dev site so both instances show the same users without dev
# clobbering prod's roster). When 1/true/yes/on the instance pulls the shared
# ADLS roster on startup + every ADMIN_STATE_REFRESH_MINUTES and disables all
# uploads; local edits are ephemeral. Leave 0 for the writable (prod) instance.
ADMIN_STATE_READONLY=0
# How often a read-only replica re-pulls the shared roster (minutes). Default 10.
ADMIN_STATE_REFRESH_MINUTES=10
# Safety: a seed/bootstrap-only roster is NEVER uploaded to the shared store, so
# a deploy that couldn't restore the real roster can't overwrite it. Set to 1
# ONLY for genuine first-time setup (no shared roster exists yet) to allow the
# initial upload; leave 0 in normal operation.
ADMIN_STATE_ALLOW_SEED_BACKUP=0

