# ── LLM Provider ─────────────────────────────────────────────────────────
# Choose provider: "anthropic" | "openai" | "azure_openai"
LLM_PROVIDER=azure_openai

# API keys — only the keys for your chosen provider are required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Azure OpenAI settings
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Model overrides (for Azure, must match your deployment names)
LLM_CHAT_MODEL=gpt-4o
LLM_EXTRACT_MODEL=gpt-4o

# ── Backend ──────────────────────────────────────────────────────────────
MOBILEAPP_TOOL_MODE=demo

# ── Frontend ─────────────────────────────────────────────────────────────
# API URL for the mobile app (default: http://127.0.0.1:3000)
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# ── Synapse Data Warehouse ───────────────────────────────────────────────
SYNAPSE_SERVER=allworthsynapse.sql.azuresynapse.net
SYNAPSE_DATABASE=DataWarehouse
SYNAPSE_DRIVER=ODBC Driver 18 for SQL Server

# Auth mode: "entra" (Azure AD/managed identity) | "sql" | "service_principal"
SYNAPSE_AUTH_MODE=entra

# SQL auth (only if SYNAPSE_AUTH_MODE=sql)
# SYNAPSE_USERNAME=
# SYNAPSE_PASSWORD=

# Service principal auth (only if SYNAPSE_AUTH_MODE=service_principal)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

